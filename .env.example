# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_BASE_URL=https://dws.example.com
DATABASE_PATH=/app/data/dws.sqlite
TRUST_PROXY=true

# Authentication: google or dev. Never use dev in production.
AUTH_MODE=google
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-a-64-hex-character-key
SESSION_TTL_HOURS=8
COOKIE_SECURE=true

# Google OAuth / Google Sheets import
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dws.example.com/auth/google/callback
GOOGLE_SHEETS_SCOPE=true

# First-run bootstrap admin. The user must authenticate with this email.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Local development only
DEV_USER_EMAIL=admin@example.com
DEV_USER_NAME=Local Admin
ALLOW_DEV_AUTH=false

# Limits
MAX_RPC_BODY_BYTES=12582912
