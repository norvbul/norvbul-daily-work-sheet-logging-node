[Unit]
Description=Daily Work Sheet Logging Node.js Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dws
EnvironmentFile=/opt/dws/.env
ExecStart=/usr/bin/node /opt/dws/src/server.mjs
Restart=on-failure
RestartSec=5
User=dws
Group=dws
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dws/data /opt/dws/backups

[Install]
WantedBy=multi-user.target
